# Operating system and editor droppings
.DS_Store
*.swp
*.bak

# Go build and test artifacts
*.exe
*.test
*.prof

# Build products, rebuilt by make; never committed
/bin/
/dist/
/man/
*.zip
*.tar.gz
*.tgz
/release_notes.tmp
/_codemeta.json

# NOTE: testdata/ and .github/ are deliberately NOT ignored. testdata/ holds
# captured CrossRef responses the tests read (nothing writes into it), and
# .github/ holds the workflow that builds the documentation site.
